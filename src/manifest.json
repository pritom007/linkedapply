{
  "manifest_version": 3,
  "name": "LinkedIn Job → ATS CV Generator",
  "version": "1.0.0",
  "description": "Generate ATS-friendly CVs and cover letters from LinkedIn job postings",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://api.groq.com/*"
  ],
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/jobs/*"],
      "js": ["content/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup/index.html"
  },
  "options_page": "options/index.html",
  "web_accessible_resources": [
    {
      "resources": ["renderer/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
